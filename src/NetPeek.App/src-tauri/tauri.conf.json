{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPeek",
  "version": "0.1.0",
  "identifier": "com.netpeek.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetPeek",
        "width": 1180,
        "height": 720,
        "resizable": true,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "mini",
        "title": "NetPeek 小窗",
        "url": "mini.html",
        "width": 108,
        "height": 108,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico", "icons/icon-32.png", "icons/icon-128.png"],
    "windows": {
      "wix": {
        "upgradeCode": "060676ca-7130-5fa3-9fb8-4bc7559b65d1",
        "fragmentPaths": ["installer/collector.wxs"],
        "componentGroupRefs": ["NetPeekCollectorComponents"]
      }
    }
  }
}
