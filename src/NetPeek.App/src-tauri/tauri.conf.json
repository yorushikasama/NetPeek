{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPeek",
  "version": "0.1.0",
  "identifier": "com.netpeek.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetPeek",
        "width": 1180,
        "height": 720,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 560
      },
      {
        "label": "mini",
        "title": "NetPeek 小窗",
        "url": "mini.html",
        "width": 100,
        "height": 100,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
