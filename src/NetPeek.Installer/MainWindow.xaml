<Window x:Class="NetPeek.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPeek 安装程序" Width="760" Height="500"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ══ 标题栏：panel-2 通栏 + 标准窗控（.winbtns 同规格）══ -->
        <Border Grid.Row="0" Background="{StaticResource Panel2Brush}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="assets/icon.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NetPeek 安装程序" FontSize="12"
                               Foreground="{StaticResource Text2Brush}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Style="{StaticResource WinBtn}" Click="OnMinimizeClick"
                            ToolTip="最小化" AutomationProperties.Name="最小化">
                        <Path Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0,5 H10"/>
                    </Button>
                    <Button Style="{StaticResource WinBtnDanger}" Click="OnCloseClick"
                            ToolTip="关闭" AutomationProperties.Name="关闭">
                        <Path Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0,0 L10,10 M10,0 L0,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 主体：左品牌区（panel）+ 右内容区（bg）══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <StackPanel VerticalAlignment="Center" Margin="28,0,24,0">
                    <Image Width="88" Height="88" HorizontalAlignment="Left"
                           Source="assets/icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NetPeek" FontSize="28" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}" Margin="0,18,0,0"/>
                    <TextBlock Text="看得见的网络流量" FontSize="13"
                               Foreground="{StaticResource Text2Brush}" Margin="0,6,0,0"/>
                    <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,20,0,18"/>
                    <TextBlock x:Name="BrandVersion" Text="版本 0.1.0" FontSize="12"
                               Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="主程序 + 采集服务（Windows 服务）" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Text3Brush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="36,0,36,0">
                <!-- 页 1：欢迎 / 选项 -->
                <Grid x:Name="WelcomePage">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="准备安装" FontSize="20" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" LineHeight="21"
                                   Text="将安装 NetPeek 主程序，并把采集服务（NetPeek.Collector）注册为 Windows 服务随系统自启。安装过程需要管理员权限；如已安装旧版本（含 MSI 版），将自动迁移。"/>

                        <TextBlock Text="安装位置" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   Margin="0,26,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Panel2Brush}" CornerRadius="8"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,7">
                                <TextBox x:Name="DirBox" Background="Transparent"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                         CaretBrush="{StaticResource AccentBrush}"/>
                            </Border>
                            <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0"
                                    Style="{StaticResource BtnGhost}" Click="OnBrowseClick"/>
                        </Grid>
                        <TextBlock x:Name="DirError" FontSize="12" Foreground="{StaticResource ErrBrush}"
                                   Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                        <CheckBox x:Name="DesktopShortcutBox" Content="创建桌面快捷方式" FontSize="13"
                                  Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,22,0,0"
                                  Cursor="Hand"/>

                        <Button x:Name="InstallBtn" Content="开始安装" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Left" Margin="0,28,0,0" Click="OnInstallClick"/>
                    </StackPanel>
                </Grid>

                <!-- 页 2：安装中 -->
                <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressTitle" Text="正在安装…" FontSize="20" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}"/>
                        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100" Margin="0,22,0,0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource Panel2Brush}" BorderThickness="0"/>
                        <StackPanel x:Name="StepList" Margin="0,22,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 页 3：完成 -->
                <Grid x:Name="DonePage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="安装完成" FontSize="20" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="DoneNote" FontSize="13" Foreground="{StaticResource Text2Brush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"
                                   Text="采集服务已随系统启动，打开主界面即可看到各应用的实时流量。"/>
                        <CheckBox x:Name="RunNowBox" Content="立即运行 NetPeek" FontSize="13"
                                  Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,24,0,0"
                                  Cursor="Hand"/>
                        <Button Content="完成" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                Margin="0,26,0,0" Click="OnFinishClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
